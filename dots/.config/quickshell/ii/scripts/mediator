#!/usr/bin/env bash
# Mediator backend launcher for the Quickshell build.
#
# The backend is one Rust binary, scripts/mediatorRs/mediator-rs, compiled from the source beside it
# by rust-helpers.sh (the shell builds it on demand). An older vendor/mediator-rs is still used
# while the new one is missing, then a system-wide `mediator` on PATH.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
root="$(cd -- "$(dirname -- "$self")/.." && pwd)"

# Downloads queue their direct streams in the shell's Downloads app (mediator download ...)
export MEDIATOR_YTDL="${MEDIATOR_YTDL:-python3 $root/scripts/ytdl/ytdl.py}"

if [ -x "$root/scripts/mediatorRs/mediator-rs" ]; then
    exec "$root/scripts/mediatorRs/mediator-rs" "$@"
fi

if [ -x "$root/vendor/mediator-rs" ]; then
    exec "$root/vendor/mediator-rs" "$@"
fi

system="$(command -v mediator || true)"
if [ -n "$system" ] && [ "$(readlink -f -- "$system")" != "$self" ]; then
    exec "$system" "$@"
fi

echo "mediator: backend not found (expected $root/scripts/mediatorRs/mediator-rs)" >&2
echo "mediator: run scripts/rust-helpers.sh build mediator-rs, or install the mediator package" >&2
exit 127
