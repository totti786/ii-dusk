--- /dev/null
+++ b/internal/voice/speaker_conceal_test.go
@@ -0,0 +1,60 @@
+//go:build !no_voice
+
+package voice
+
+import (
+	"testing"
+
+	"github.com/tphakala/go-opus/opus"
+)
+
+func TestSpeakerConcealsLatePacket(t *testing.T) {
+	enc, err := opus.NewEncoder(opus.EncoderConfig{SampleRate: sampleRate, Channels: channels})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	pcm := make([]int16, frameSamples)
+	for i := range pcm {
+		pcm[i] = int16(3000 * (i % 100) / 100)
+	}
+
+	packet := func() []byte {
+		out := make([]byte, maxPacketBytes)
+		n, err := enc.Encode(pcm, out)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return out[:n]
+	}
+
+	s, err := newSpeaker(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for seq := uint16(1); seq <= 6; seq++ {
+		if err := s.write(seq, packet()); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// Drain more than is buffered: the shortfall is made up, up to maxLost frames.
+	acc := make([]int32, frameSamples*10)
+	s.mix(acc)
+	if s.concealed == 0 || s.concealed > maxLost {
+		t.Fatalf("concealed = %d, want 1..%d", s.concealed, maxLost)
+	}
+
+	// The late packets arrive: they are not played again.
+	before := s.concealed
+	for seq := uint16(7); seq < 7+uint16(before); seq++ {
+		if err := s.write(seq, packet()); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	if s.concealed != 0 || len(s.buf) != 0 {
+		t.Fatalf("concealed = %d, buffered = %d, want 0, 0", s.concealed, len(s.buf))
+	}
+}
