#!/usr/bin/env bash
# Fallback lock, run by hypridle only when the ii shell is not running
# (the shell has its own lock screen). Pauses KDE Connect media, then locks.
if playerctl -i kdeconnect -a status 2>/dev/null | grep -q '^Playing$'; then
	playerctl -i kdeconnect -a pause
fi
pgrep -x hyprlock >/dev/null || exec hyprlock
