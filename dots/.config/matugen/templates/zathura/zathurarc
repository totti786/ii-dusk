set recolor "true"

set completion-bg "{{colors.surface.default.hex}}"
set completion-fg "{{colors.on_surface.default.hex}}"
set completion-group-bg "{{colors.surface.default.hex}}"
set completion-group-fg "{{colors.primary.default.hex}}"
set completion-highlight-bg "{{colors.on_surface.default.hex}}"
set completion-highlight-fg "{{colors.surface.default.hex}}"

set recolor-lightcolor "{{colors.surface.default.hex}}"
set recolor-darkcolor "{{colors.on_surface.default.hex}}"
set default-bg "{{colors.surface.default.hex}}"

set inputbar-bg "{{colors.surface.default.hex}}"
set inputbar-fg "{{colors.on_surface.default.hex}}"
set notification-bg "{{colors.surface.default.hex}}"
set notification-fg "{{colors.on_surface.default.hex}}"
set notification-error-bg "{{colors.error.default.hex}}"
set notification-error-fg "{{colors.on_error.default.hex}}"
set notification-warning-bg "{{colors.error.default.hex}}"
set notification-warning-fg "{{colors.on_error.default.hex}}"
set statusbar-bg "{{colors.surface_container.default.hex}}"
set statusbar-fg "{{colors.on_surface.default.hex}}"
set index-bg "{{colors.surface.default.hex}}"
set index-fg "{{colors.on_surface.default.hex}}"
set index-active-bg "{{colors.on_surface.default.hex}}"
set index-active-fg "{{colors.surface.default.hex}}"
set render-loading-bg "{{colors.surface.default.hex}}"
set render-loading-fg "{{colors.on_surface.default.hex}}"

set database sqlite

set recolor-keephue "true"
set guioptions none
set window-title-home-tilde true
set window-title-basename true
set window-title-page true
set statusbar-basename true
set selection-clipboard clipboard

map h feedkeys "<C-Left>"
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
map l feedkeys "<C-Right>"
